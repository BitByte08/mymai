{
  "name": "carol",
  "version": "1.0.0",
  "description": "maimai DX net profile Discord bot",
  "main": "dist/bot/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot/index.js",
    "dev": "ts-node src/bot/index.ts",
    "dev:web": "ts-node src/web/dev.ts",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "test:unit": "node --require ./test/setup.cjs --test test/unit/achievements.test.js test/unit/aliases.test.js test/unit/bookmarklet.test.js test/unit/constants.test.js test/unit/crypto.test.js test/unit/games.test.js test/unit/goals.test.js test/unit/scraper.test.js",
    "pretest:integration": "node -e \"const fs=require('fs');fs.existsSync('config.json')||fs.copyFileSync('config.json.example','config.json')\"",
    "test:integration": "npm run build && node --test test/postgres.integration.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.6",
    "cheerio": "^1.2.0",
    "discord.js": "^14.26.4",
    "express": "^5.2.1",
    "jimp": "^1.6.1",
    "node-forge": "^1.4.0",
    "pg": "^8.22.0",
    "satori": "^0.26.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
